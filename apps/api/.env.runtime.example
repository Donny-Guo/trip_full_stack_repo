# Copy to .env.runtime.local, replace every placeholder, and chmod 600 the
# populated ignored file. Never place migrator/provisioner credentials here.
NODE_ENV=development
API_PORT=3001
API_RUNTIME_DATABASE_URL=postgresql://trip_runtime:<percent-encoded-runtime-password>@127.0.0.1:5432/trip
API_TRUST_PROXY_HOPS=0
API_CORS_ORIGINS=http://localhost:3000
API_TRUSTED_ORIGINS=http://localhost:3000
API_JSON_BODY_LIMIT_BYTES=16384

# Generate 32 random bytes and base64-encode them. Never commit the result.
AUTH_JWT_SECRET_BASE64=
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_HASH_CONCURRENCY=2
AUTH_PASSWORD_HASH_QUEUE_LIMIT=32

# A fixed non-user Argon2id hash. Never derive this from a real password.
AUTH_DUMMY_PASSWORD_HASH=
