# Copy to .env.runtime.local and replace the password placeholder with the
# URL-encoded runtime password from .env.compose.local. Generate independent
# test-only JWT and dummy-hash values; never commit the populated local file.
NODE_ENV=test
API_PORT=3001
API_RUNTIME_DATABASE_URL=postgresql://trip_runtime:<percent-encoded-runtime-password>@127.0.0.1:55432/trip_auth_api_test
API_TRUST_PROXY_HOPS=0
API_CORS_ORIGINS=http://localhost:3000
API_TRUSTED_ORIGINS=http://localhost:3000
API_JSON_BODY_LIMIT_BYTES=16384
AUTH_JWT_SECRET_BASE64=
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_HASH_CONCURRENCY=2
AUTH_PASSWORD_HASH_QUEUE_LIMIT=32
AUTH_DUMMY_PASSWORD_HASH=
