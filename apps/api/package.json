{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:show": "typeorm-ts-node-esm migration:show -d src/database/migration-data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/migration-data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/migration-data-source.ts",
    "migration:test:show": "typeorm-ts-node-esm migration:show -d test/helpers/migration-test-data-source.ts",
    "migration:test:run": "typeorm-ts-node-esm migration:run -d test/helpers/migration-test-data-source.ts",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:integration:local": "bash ./test/run-integration-local.sh",
    "test:config:generate": "node ./test/generate-local-test-config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie": "2.0.1",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@trip/config-eslint": "workspace:*",
    "@trip/config-typescript": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.3",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
