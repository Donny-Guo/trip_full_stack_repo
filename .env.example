# Local PostgreSQL/pgvector provisioning only. Never use these placeholders
# outside local development. API process settings belong in the separate
# apps/api/.env.runtime.local and apps/api/.env.migration.local files; see
# docs/api/authentication.md.
TRIP_DB_PORT=5432
TRIP_DB_NAME=trip

TRIP_DB_PROVISIONER_USER=trip_provisioner
TRIP_DB_PROVISIONER_PASSWORD=

TRIP_DB_MIGRATOR_USER=trip_migrator
TRIP_DB_MIGRATOR_PASSWORD=

TRIP_DB_RUNTIME_USER=trip_runtime
TRIP_DB_RUNTIME_PASSWORD=
